# Copy to .env and adjust for your local LLM server.

# --- LM Studio (default) ---
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-2-9b-it
LLM_API_KEY=local-no-key-needed

# --- Ollama ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma2:9b
# LLM_API_KEY=ollama

# --- Anything else OpenAI-compatible (vLLM, TGI, llama.cpp server, OpenAI itself) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

LLM_TEMPERATURE=0.0
